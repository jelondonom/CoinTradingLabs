# Copia este archivo a `.env` solo si necesitas cambiar un valor.
# En desarrollo todas las variables tienen valor por defecto (ver `src/env.ts` de cada app).
# En producción DATABASE_URL y REDIS_URL son obligatorias.

NODE_ENV=development
LOG_LEVEL=info

# --- infra/docker-compose.yml (solo desarrollo local) ---
POSTGRES_USER=coin
POSTGRES_PASSWORD=coin
POSTGRES_DB=coin
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- apps/api ---
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://coin:coin@localhost:5432/coin
REDIS_URL=redis://localhost:6379
# Secreto con el que se firman los tokens de sesión (mínimo 32 caracteres).
# Obligatorio en producción; en desarrollo hay un valor por defecto.
# AUTH_TOKEN_SECRET=
# Duración de la sesión, en horas.
AUTH_TOKEN_TTL_HOURS=168
# Antigüedad máxima de un tick para ejecutar una orden, en milisegundos.
STALE_PRICE_AFTER_MS=30000

# --- apps/market-data ---
MARKET_DATA_HOST=0.0.0.0
MARKET_DATA_PORT=3001
# Intervalo del simulador de precios V0, en milisegundos.
TICK_INTERVAL_MS=1000
